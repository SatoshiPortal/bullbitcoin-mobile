build/
.dart_tool/
.gradle/
android/.gradle/
ios/
.idea/
.vscode/
*.iml

# Host-side Flutter version cache (FVM downloads its own copy in the container)
.fvm/

# Local APKs/AABs built previously (host-side artifacts)
BULL-*.apk
BULL-*.aab
app-*.apk
app-*.aab

# Local investigation / verification scratch dirs
.tmp_apk_diff/
reproducibility/bullbitcoin_*_verification/
reproducibility/reproducibility_test_*/

# Secrets — must never enter a build image layer, even one that's later
# deleted (secrets baked into an intermediate layer persist in the image
# cache/registry history). .gitignore already excludes these from commits;
# .dockerignore does not inherit .gitignore, so they need their own entries.
# NOTE: dockerignore patterns follow Go filepath.Match, NOT gitignore: a bare
# `*.keystore` matches only at the context root, so nested paths need `**/`.
# The one keystore the build genuinely needs is re-included below; CI-written
# beta signing files (android/key-beta.properties + beta-upload.keystore) are
# deliberately NOT excluded — build.gradle must see them inside the image to
# sign the beta channel, and the CI runner is already the secret boundary
# there. Everything else keeps secrets out of layers.
**/.env
android/key.properties
**/*.keystore
**/*.jks
!android/app/debug.keystore
!android/app/beta-upload.keystore

# Stale host-generated code. These are gitignored and regenerated inside the
# image by `make build-runner` / `make translations`, but .dockerignore
# doesn't inherit .gitignore — without these entries a locally generated (and
# possibly stale) file gets COPYed in ahead of the in-image regeneration.
lib/generated/
**/*.freezed.dart
**/*.g.dart
untranslated-messages.txt
integration_test/all_test.dart

# Editor/scratch/log artifacts irrelevant to the build
**/*.swp
bull_logs.tsv

# Host-extracted build artifacts that don't match the BULL-*.apk/aab globs
# above (e.g. verification-workflow output named without an extension)
BULL-release-*
