#!/bin/bash
echo "Begin pre-commit hook"

REPO_ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$REPO_ROOT" || exit 1

scratch="$(mktemp -d)" || exit 1
trap 'rm -f "$scratch"/{paths,blob,analyze,fix}; rmdir "$scratch"' EXIT

# Read the active index before clearing Git's environment for the Dart SDK.
git diff --cached --name-only -z --diff-filter=ACMR > "$scratch/paths" || exit 1
has_dart=false
has_coins_ui=false
format_paths=()
while IFS= read -r -d '' path; do
  case "$path" in
    features/coins/lib/src/ui/*) has_coins_ui=true ;;
  esac
  [[ "$path" == *.dart ]] || continue
  has_dart=true
  # Keep the exclusions in sync with the makefile's format-check target.
  case "$path" in
    *.g.dart|*.freezed.dart|*.gr.dart|*.config.dart|*.mocks.dart|*.steps.dart|*/generated/*) continue ;;
  esac
  format_paths+=("$path")
done < "$scratch/paths"

without_git_context() (
  # Flutter uses git describe to detect its SDK version.
  unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX
  "$@"
)

if $has_dart; then
  # Prefer FVM Flutter if present; else try fvm; else use the SDK on PATH.
  if [[ -x "$REPO_ROOT/.fvm/flutter_sdk/bin/flutter" ]]; then
    FLUTTER=("$REPO_ROOT/.fvm/flutter_sdk/bin/flutter")
    DART=("$REPO_ROOT/.fvm/flutter_sdk/bin/dart")
  elif command -v fvm >/dev/null 2>&1; then
    FLUTTER=(fvm flutter)
    DART=(fvm dart)
  else
    FLUTTER=(flutter)
    DART=(dart)
  fi

  check_staged_format() {
    local path
    local matching_paths=()
    local format=("${DART[@]}" format --output=none --set-exit-if-changed)

    for path in "${format_paths[@]}"; do
      git show ":0:$path" > "$scratch/blob" || return 1
      if [[ -f "$path" ]] && cmp -s -- "$scratch/blob" "$path"; then
        matching_paths+=("./$path")
      else
        # Preserve the destination path so the formatter sees the member's
        # configuration even if the working file is missing or differs.
        without_git_context "${format[@]}" --stdin-name "./$path" < "$scratch/blob" || return 1
      fi
    done

    if (( ${#matching_paths[@]} )); then
      without_git_context "${format[@]}" "${matching_paths[@]}"
    fi
  }

  if ! check_staged_format; then
    echo "Staged Dart format check failed. Format and stage the intended changes."
    exit 1
  fi

  unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX
  echo "Using Flutter: $("${FLUTTER[@]}" --version | head -n1)"

  # Run analyze and dart fix in parallel after the staged format check.
  analyzeOut="$scratch/analyze"
  fixOut="$scratch/fix"
  start=$SECONDS

  make analyze >"$analyzeOut" 2>&1 &
  analyzePid=$!

  "${DART[@]}" fix --dry-run >"$fixOut" 2>&1 &
  fixPid=$!

  wait "$analyzePid"; analyzeExit=$?
  wait "$fixPid"; fixExit=$?

  echo "analyze + dart fix took $((SECONDS - start))s (parallel)"

  if [ $analyzeExit -ne 0 ]; then
    cat "$analyzeOut"
    echo "Flutter analyze found issues, please fix them."
    exit 1
  fi

  if [[ $fixExit -ne 0 ]] || ! grep -q "Nothing to fix!" "$fixOut"; then
    cat "$fixOut"
    echo "dart fix has suggestions, run \`dart fix --apply\` and commit the result."
    exit 1
  fi
else
  echo "No Dart/pub files staged — skipping analyze + dart fix + format."
fi

# bull_ui import boundary: feature UI built on the design system must import
# only `package:bull_ui/bull_ui.dart` for widgets — never Flutter UI directly.
# (Until a first-party analyzer rule lands, this grep is the enforcement.)
# Only relevant when files under the coins UI are staged.
if $has_coins_ui; then
  if grep -rEl "package:(flutter/(material|cupertino|widgets)|material_ui/material_ui|cupertino_ui/cupertino_ui)\.dart" "$REPO_ROOT/features/coins/lib/src/ui" >/dev/null 2>&1; then
    echo "features/coins/lib/src/ui must import only package:bull_ui/bull_ui.dart, not Flutter or standalone Material/Cupertino UI:"
    grep -rEl "package:(flutter/(material|cupertino|widgets)|material_ui/material_ui|cupertino_ui/cupertino_ui)\.dart" "$REPO_ROOT/features/coins/lib/src/ui"
    exit 1
  fi
fi

echo "End pre-commit hook"
