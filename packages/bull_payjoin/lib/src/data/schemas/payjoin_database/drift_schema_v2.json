  "fixed_sql": [
    {
      "name": "payjoin_senders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"payjoin_senders\" (\"uri\" TEXT NOT NULL, \"is_testnet\" INTEGER NOT NULL CHECK (\"is_testnet\" IN (0, 1)), \"sender\" TEXT NOT NULL, \"wallet_id\" TEXT NOT NULL, \"original_psbt\" TEXT NOT NULL, \"original_tx_id\" TEXT NOT NULL, \"amount_sat\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"expire_after_sec\" INTEGER NOT NULL, \"proposal_psbt\" TEXT NULL, \"tx_id\" TEXT NULL, \"is_expired\" INTEGER NOT NULL CHECK (\"is_expired\" IN (0, 1)), \"is_completed\" INTEGER NOT NULL CHECK (\"is_completed\" IN (0, 1)), \"is_aborted\" INTEGER NOT NULL CHECK (\"is_aborted\" IN (0, 1)), PRIMARY KEY (\"uri\"));"
        }
      ]
    },
    {
      "name": "payjoin_receivers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"payjoin_receivers\" (\"id\" TEXT NOT NULL, \"address\" TEXT NOT NULL, \"is_testnet\" INTEGER NOT NULL CHECK (\"is_testnet\" IN (0, 1)), \"receiver\" TEXT NOT NULL, \"wallet_id\" TEXT NOT NULL, \"pj_uri\" TEXT NOT NULL, \"max_fee_rate_sat_per_vb\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"expire_after_sec\" INTEGER NOT NULL, \"original_tx_bytes\" BLOB NULL, \"original_tx_id\" TEXT NULL, \"amount_sat\" INTEGER NULL, \"proposal_psbt\" TEXT NULL, \"tx_id\" TEXT NULL, \"is_expired\" INTEGER NOT NULL CHECK (\"is_expired\" IN (0, 1)), \"is_completed\" INTEGER NOT NULL CHECK (\"is_completed\" IN (0, 1)), \"is_aborted\" INTEGER NOT NULL CHECK (\"is_aborted\" IN (0, 1)), \"is_trade\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_trade\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "payjoin_policies",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"payjoin_policies\" (\"id\" INTEGER NOT NULL, \"enabled\" INTEGER NOT NULL CHECK (\"enabled\" IN (0, 1)), \"trading_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"trading_enabled\" IN (0, 1)), \"send_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"send_enabled\" IN (0, 1)), \"minimum_amount_sat\" INTEGER NOT NULL, \"session_lifetime_seconds\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "payjoin_migrations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"payjoin_migrations\" (\"name\" TEXT NOT NULL, \"completed_at\" INTEGER NOT NULL, \"source_schema_version\" INTEGER NOT NULL, \"sender_count\" INTEGER NOT NULL, \"receiver_count\" INTEGER NOT NULL, \"verification_digest\" TEXT NOT NULL, PRIMARY KEY (\"name\"));"
        }
      ]
    }
