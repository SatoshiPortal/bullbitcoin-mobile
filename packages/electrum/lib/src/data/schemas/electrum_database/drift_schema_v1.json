    {
      "name": "electrum_servers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"electrum_servers\" (\"url\" TEXT NOT NULL, \"network\" TEXT NOT NULL, \"priority\" INTEGER NOT NULL, \"is_custom\" INTEGER NOT NULL CHECK (\"is_custom\" IN (0, 1)), PRIMARY KEY (\"network\", \"url\"));"
        }
      ]
    },
    {
      "name": "electrum_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"electrum_settings\" (\"network\" TEXT NOT NULL, \"validate_domain\" INTEGER NOT NULL CHECK (\"validate_domain\" IN (0, 1)), \"stop_gap\" INTEGER NOT NULL, \"timeout\" INTEGER NOT NULL, \"retry\" INTEGER NOT NULL, \"socks5\" TEXT NULL, PRIMARY KEY (\"network\"));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"txid\" TEXT NOT NULL, \"version\" INTEGER NOT NULL, \"size\" TEXT NOT NULL, \"vsize\" TEXT NOT NULL, \"locktime\" INTEGER NOT NULL, \"vin\" TEXT NOT NULL, \"vout\" TEXT NOT NULL, \"blockhash\" TEXT NULL, \"height\" INTEGER NULL, \"confirmations\" INTEGER NULL, \"time\" INTEGER NULL, \"blocktime\" INTEGER NULL, PRIMARY KEY (\"txid\"));"
        }
      ]
    },
