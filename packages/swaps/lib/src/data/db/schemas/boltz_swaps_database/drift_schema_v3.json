  "fixed_sql": [
    {
      "name": "swaps",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"swaps\" (\"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"direction\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"is_testnet\" INTEGER NOT NULL CHECK (\"is_testnet\" IN (0, 1)), \"key_index\" INTEGER NOT NULL, \"creation_time\" INTEGER NOT NULL, \"completion_time\" INTEGER NULL, \"receive_wallet_id\" TEXT NULL, \"send_wallet_id\" TEXT NULL, \"invoice\" TEXT NULL, \"payment_address\" TEXT NULL, \"payment_amount\" INTEGER NULL, \"receive_address\" TEXT NULL, \"receive_txid\" TEXT NULL, \"send_txid\" TEXT NULL, \"preimage\" TEXT NULL, \"refund_address\" TEXT NULL, \"refund_txid\" TEXT NULL, \"boltz_fees\" INTEGER NULL, \"lockup_fees\" INTEGER NULL, \"claim_fees\" INTEGER NULL, \"refund_fees\" INTEGER NULL, \"server_network_fees\" INTEGER NULL, \"was_direct_payment\" INTEGER NOT NULL DEFAULT 0 CHECK (\"was_direct_payment\" IN (0, 1)), \"recovered\" INTEGER NOT NULL DEFAULT 0 CHECK (\"recovered\" IN (0, 1)), \"pending_lockup_tx\" TEXT NULL, \"pending_lockup_txid\" TEXT NULL, \"provider\" TEXT NOT NULL DEFAULT 'boltz', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "swap_data_migrations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"swap_data_migrations\" (\"name\" TEXT NOT NULL, \"completed_at\" INTEGER NOT NULL, PRIMARY KEY (\"name\"));"
        }
      ]
    },
    {
      "name": "auto_swap",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"auto_swap\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)), \"balance_threshold_sats\" INTEGER NOT NULL, \"trigger_balance_sats\" INTEGER NOT NULL, \"fee_threshold_percent\" REAL NOT NULL, \"block_till_next_execution\" INTEGER NOT NULL DEFAULT 0 CHECK (\"block_till_next_execution\" IN (0, 1)), \"always_block\" INTEGER NOT NULL DEFAULT 0 CHECK (\"always_block\" IN (0, 1)), \"recipient_wallet_id\" TEXT NULL, \"show_warning\" INTEGER NOT NULL DEFAULT 1 CHECK (\"show_warning\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "legacy_import_receipts",
      "sql": [
        {
          "dialect": "sqlite",
