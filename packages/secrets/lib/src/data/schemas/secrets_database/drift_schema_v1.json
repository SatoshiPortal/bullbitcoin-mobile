  "fixed_sql": [
    {
      "name": "wallets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"wallets\" (\"id\" TEXT NOT NULL, \"secret_fingerprint\" TEXT NULL, \"master_fingerprint\" TEXT NOT NULL, \"signer\" TEXT NOT NULL, \"network\" TEXT NOT NULL, \"xpub\" TEXT NOT NULL, \"external_descriptor\" TEXT NOT NULL, \"internal_descriptor\" TEXT NOT NULL, \"label\" TEXT NULL, \"birthday\" TEXT NULL, \"is_default\" INTEGER NOT NULL CHECK (\"is_default\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "derivations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"derivations\" (\"parent_fingerprint\" TEXT NOT NULL, \"path\" TEXT NOT NULL, \"application\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"alias\" TEXT NULL, PRIMARY KEY (\"parent_fingerprint\", \"path\"));"
        }
      ]
    },
    {
      "name": "credentials",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"credentials\" (\"id\" TEXT NOT NULL, \"scheme\" TEXT NOT NULL, \"salt\" BLOB NOT NULL, \"params\" TEXT NOT NULL, \"verifier\" BLOB NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "views",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"views\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"background_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"background_enabled\" IN (0, 1)), \"credential_id\" TEXT NULL REFERENCES credentials (id), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "view_members",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"view_members\" (\"view_id\" TEXT NOT NULL REFERENCES views (id) ON DELETE CASCADE, \"member\" TEXT NOT NULL, PRIMARY KEY (\"view_id\", \"member\"));"
        }
      ]
    },
    {
      "name": "access_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"access_state\" (\"singleton\" INTEGER NOT NULL, \"failed_attempts\" INTEGER NOT NULL, \"locked_until\" INTEGER NULL, \"import_receipt\" TEXT NOT NULL, PRIMARY KEY (\"singleton\"), CHECK (singleton = 1), CHECK (failed_attempts >= 0));"
        }
      ]
    }
  ]
