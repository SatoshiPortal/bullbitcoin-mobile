          "sql": "CREATE TABLE IF NOT EXISTS \"recoverbull_monitored_vaults\" (\"server\" TEXT NOT NULL, \"digest\" BLOB NOT NULL CHECK (length(digest) = 32), \"anchor_requests\" INTEGER NULL, \"observed_requests\" INTEGER NULL, \"window\" INTEGER NULL, \"collection\" INTEGER NULL, \"exact_window\" INTEGER NULL, \"own_requests\" INTEGER NOT NULL DEFAULT 0, \"unknown\" INTEGER NOT NULL DEFAULT 1 CHECK (\"unknown\" IN (0, 1)), PRIMARY KEY (\"server\", \"digest\"));"
