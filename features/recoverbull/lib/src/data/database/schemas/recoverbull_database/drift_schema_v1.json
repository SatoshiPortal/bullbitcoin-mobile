        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recoverbull_state\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"server\" TEXT NOT NULL DEFAULT 'http://5m7enm5y77tdgmaf3d5xuwa5c7fjma7v5ljtwxu4q5jtq6b5utspmpyd.onion', \"permission_granted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"permission_granted\" IN (0, 1)), \"monitoring_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"monitoring_enabled\" IN (0, 1)), \"legacy_import_complete\" INTEGER NOT NULL DEFAULT 0 CHECK (\"legacy_import_complete\" IN (0, 1)), \"monitoring_revision\" INTEGER NOT NULL DEFAULT 0, \"generation\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"), CHECK (id = 1), CHECK (generation >= 0));"
        }
      ]
